{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2022"],
    "types": ["node"],

    "rootDir": "src",
    "outDir": "dist",

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,

    "strict": false,
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "sourceMap": true
  },

  "include": [
    "src/index.ts",
    "src/types.d.ts",
    "src/controllers/**/*.ts",
    "src/routes/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/app.module.ts",
    "src/main.ts",
    "src/auth",
    "src/common",
    "src/config",
    "src/groups",
    "src/organizations",
    "src/prisma",
    "src/realtime",
    "src/storage",
    "src/tests"
  ]
}
